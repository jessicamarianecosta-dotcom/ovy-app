{
  "manifest_version": 3,
  "name": "Ovy — Transcrever WhatsApp Web",
  "version": "0.3.0",
  "description": "Adiciona um botão \"Transcrever\" em cada áudio do WhatsApp Web. Transcreve só a mensagem que você clicar, sem ficar ouvindo nada.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "tabCapture", "offscreen"],
  "host_permissions": ["https://ovy-app.vercel.app/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
